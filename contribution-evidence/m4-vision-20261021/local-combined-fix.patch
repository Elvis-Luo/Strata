+    if (wide != 10 || narrow != 40) return 1;
+    std::vector<mtl::Pipeline> scans;
+    scans.reserve(4);
+    scans.push_back(cx.pipeline(lib,"mm_scan",mtl::Constants().u(25,narrow).u(26,40)));
+    scans.push_back(cx.pipeline(lib,"mm_scan",mtl::Constants().u(25,wide).u(26,20)));
+    scans.push_back(cx.pipeline(lib,"mm_scan",mtl::Constants().u(25,narrow).u(26,40)));
+    // A legacy caller with no function constants must keep caller-supplied grid values.
+    scans.push_back(cx.pipeline(lib,"mm_scan"));
+    auto capture = cx.pipeline(lib,"capture_grid");
+    std::vector<mtl::Dispatch> ds;
+    for (uint32_t slot=0;slot<4;++slot) {
+        mtl::Dispatch sc;
+        sc.p=&scans[slot];
+        sc.args={mtl::Arg::B(counts),mtl::Arg::B(offsets),mtl::Arg::B(eoff),
+                 mtl::Arg::B(tiles),mtl::Arg::B(meta),mtl::Arg::V(plan)};
+        sc.tg[0]=32;
+        ds.push_back(sc);
+        mtl::Dispatch cp;
+        cp.p=&capture;
+        cp.args={mtl::Arg::B(meta),mtl::Arg::B(out),mtl::Arg::V(slot)};
+        cp.tg[0]=32;
+        ds.push_back(cp);
+    }
+    cx.run(ds);
+    bool ok=true;
+    for(int i=0;i<4;++i) {
+        auto row=out.as<uint32_t>()+11*i;
+        bool pass=row[2]==(i==1?wide:narrow) && row[5]==(i==1?20u:40u)
+            && row[0]==32 && row[1]==512 && row[3]==32 && row[4]==1
+            && row[6]==32 && row[7]==1 && row[8]==512 && row[9]==1 && row[10]==1;
+        std::printf("mixed layer %d: gate/up grid %u, down grid %u: %s\n",i,row[2],row[5],pass?"PASS":"FAIL");
+        ok &= pass;
+    }
+    return ok?0:1;
+}
